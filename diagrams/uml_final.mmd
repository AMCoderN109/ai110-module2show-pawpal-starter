classDiagram
    class Task {
        +String description
        +String start_time
        +Integer duration_minutes
        +String priority_level
        +String frequency
        +Boolean completed
        +Date due_date
        +Pet pet
        +mark_complete()
        +update_priority(new_priority)
        -_recurrence_days()
        -__post_init__()
    }

    class Pet {
        +String name
        +String species
        +String breed_type
        +Integer age
        +List medication_history
        +List tasks
        +add_task(task)
        +add_medical_record(record)
    }

    class Owner {
        +String first_name
        +String last_name
        +Integer age
        +String contact_info
        +String insurance_info
        +List pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Schedule {
        +Owner owner
        +String available_start_time
        +String available_end_time
        +sort_by_time()
        +sort_by_priority()
        +filter_tasks(pet_name, completed)
        +detect_conflicts()
        +conflict_warnings()
        -_task_start_minutes(task)
        -_task_end_minutes(task)
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : stores
    Task "0..*" --> "0..1" Pet : assigned to
    Schedule "1" --> "1" Owner : manages tasks for
    Schedule ..> Task : sorts, filters, and checks
